{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run TrayApp",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}\\TrayApp.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build TrayApp",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\TrayApp.csproj"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
